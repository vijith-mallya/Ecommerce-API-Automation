    {
      "name": "View order",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// 1. Verify status code",
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "// 2. Verify valid JSON response",
              "pm.test(\"Response should be valid JSON\", function () {",
              "    pm.response.to.be.json;",
              "});",
              "",
              "const response = pm.response.json();",
              "",
              "// 3. Verify success message",
              "pm.test(\"Success message should be correct\", function () {",
              "    pm.expect(response.message).to.eql(\"Orders fetched for customer Successfully\");",
              "});",
              "",
              "// 4. Verify data object exists",
              "pm.test(\"Data should be an object\", function () {",
              "    pm.expect(response.data).to.be.an(\"object\");",
              "});",
              "",
              "// 5. Verify required fields",
              "pm.test(\"All required order fields should exist\", function () {",
              "    const requiredFields = [\"_id\",\"orderById\",\"orderBy\",\"productOrderedId\",\"productName\",\"country\",\"productDescription\",\"productImage\",\"orderPrice\",\"__v\"];",
              "    requiredFields.forEach(function (field) {",
              "        pm.expect(response.data).to.have.property(field);",
              "    });",
              "});",
              "",
              "// 6. Verify order ID format",
              "pm.test(\"Order ID should be valid\", function () {",
              "    pm.expect(response.data._id).to.match(/^[a-fA-F0-9]{24}$/);",
              "});",
              "",
              "// 7. Verify customer email",
              "pm.test(\"Customer email should be valid\", function () {",
              "    pm.expect(response.data.orderBy).to.match(/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/);",
              "});",
              "",
              "// 8. Verify country",
              "pm.test(\"Country should be India\", function () {",
              "    pm.expect(response.data.country).to.eql(\"India\");",
              "});",
              "",
              "// 9. Verify product name",
              "pm.test(\"Product name should not be empty\", function () {",
              "    pm.expect(response.data.productName).to.not.be.empty;",
              "});",
              "",
              "// 10. Verify order price",
              "pm.test(\"Order price should be a valid positive number\", function () {",
              "    pm.expect(Number(response.data.orderPrice)).to.be.above(0);",
              "});",
              "",
              "// 11. Verify product image URL",
              "pm.test(\"Product image should be a valid URL\", function () {",
              "    pm.expect(response.data.productImage).to.match(/^https?:\\/\\/.+/);",
              "});",
              "",
              "// 12. Verify version",
              "pm.test(\"Version should be zero\", function () {",
              "    pm.expect(response.data.__v).to.eql(0);",
              "});",
              "",
              "// 13. Verify response time",
              "pm.test(\"Response time should be below 2000 ms\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(2000);",
              "});"
            ]
          }
        }
